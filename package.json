{
  "name": "test-capabilities",
  "version": "0.1.0",
  "description": "Testing infrastructure for the AI-native era — TEST-CAPABILITIES framework, LLM-driven testing guides, autonomous quality assurance",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "tc": "./bin/test-capabilities",
    "test-capabilities": "./bin/test-capabilities"
  },
  "files": [
    "bin/",
    "dist/",
    "README.md",
    "test-capabilities.yaml"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "fix": "bash ./scripts/quality-gate.sh fix",
    "lint": "bash ./scripts/quality-gate.sh lint",
    "typecheck": "bash ./scripts/quality-gate.sh typecheck",
    "quality:pre-commit": "bash ./scripts/quality-gate.sh pre-commit",
    "quality:pre-push": "bash ./scripts/quality-gate.sh pre-push",
    "quality:ci": "bash ./scripts/quality-gate.sh ci",
    "check": "npm run quality:ci",
    "consumer:smoke": "node ./scripts/consumer_contract_smoke.mjs",
    "truth:gate": "node ./scripts/capability-truth-gate.mjs",
    "truth:gate:local": "TEST_CAPABILITIES_REQUIRE_AK_DIRECTION=1 node ./scripts/capability-truth-gate.mjs",
    "release:check": "npm run check && npm run truth:gate && npm run release:check:quick",
    "release:check:quick": "npm run consumer:smoke",
    "test": "npm run build --silent && node --test tests/*.test.mjs",
    "test:property": "npm run build --silent && node --test tests/property_contract.test.mjs",
    "test:behavior": "npm run build --silent && cucumber-js --import tests/behavior/**/*.steps.mjs tests/behavior/**/*.feature",
    "test:behavior:raw": "cucumber-js --import tests/behavior/**/*.steps.mjs tests/behavior/**/*.feature",
    "test:ci-targeted": "node ./scripts/run_ci_targeted_tests.mjs",
    "test:runtime": "RUN_CONVEX_RUNTIME_TESTS=1 node --test tests/convex_runtime_contract_enforcement.test.mjs",
    "ci:smoke": "bash ./scripts/ci/smoke.sh",
    "ci:full": "bash ./scripts/ci/full.sh",
    "docs:list": "bash ./scripts/docs-list.sh",
    "docs:list:workspace": "bash ./scripts/docs-list.sh --workspace --discover",
    "docs:list:json": "bash ./scripts/docs-list.sh --json",
    "tech-stack": "bash ./scripts/tech-stack.sh",
    "capability:drill": "bash ./scripts/capability-drill.sh",
    "bombadil:smoke": "bash ./scripts/bombadil-rich-smoke.sh",
    "capability:passport": "npm run build --silent && node ./scripts/generate-capability-passport.mjs",
    "screening:witness-refresh": "bash ./scripts/screening/ts-quality-witness-refresh.sh",
    "screening:check": "bash ./scripts/screening/ts-quality-check.sh",
    "test-capabilities": "npm run build --silent && node ./bin/test-capabilities",
    "prepack": "npm run build"
  },
  "keywords": [
    "testing",
    "ai",
    "autonomous",
    "self-healing",
    "predictive",
    "browser-automation",
    "fuzzing",
    "quantum-testing",
    "test-capabilities"
  ],
  "dependencies": {
    "chalk": "^4.1.2",
    "commander": "^12.0.0",
    "figlet": "^1.7.0",
    "js-yaml": "^4.1.0",
    "ora": "^5.4.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.14",
    "@cucumber/cucumber": "^12.8.1",
    "@types/figlet": "^1.5.8",
    "@types/node": "^22.0.0",
    "fast-check": "^4.7.0",
    "typescript": "^5.3.0",
    "vitest": "^1.2.0"
  }
}
