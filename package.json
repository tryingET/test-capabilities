{
  "name": "test-capabilities",
  "version": "0.3.0",
  "description": "Fail-closed testing capability framework with CLI, browser, property, healing, and diagnostic root-cause surfaces",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tryingET/test-capabilities.git"
  },
  "bugs": {
    "url": "https://github.com/tryingET/test-capabilities/issues"
  },
  "homepage": "https://github.com/tryingET/test-capabilities#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "tc": "bin/test-capabilities",
    "test-capabilities": "bin/test-capabilities"
  },
  "files": [
    "bin/",
    "dist/",
    "examples/demo/",
    "schemas/",
    "README.md",
    "test-capabilities.yaml"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "fix": "bash ./scripts/quality-gate.sh fix",
    "lint": "bash ./scripts/quality-gate.sh lint",
    "typecheck": "bash ./scripts/quality-gate.sh typecheck",
    "quality:pre-commit": "bash ./scripts/quality-gate.sh pre-commit",
    "quality:pre-push": "bash ./scripts/quality-gate.sh pre-push",
    "quality:ci": "bash ./scripts/quality-gate.sh ci",
    "check": "npm run quality:ci",
    "verify": "npm run release:check",
    "verify:ci": "npm run release:check",
    "smoke:packaging": "npm run consumer:smoke",
    "consumer:smoke": "node ./scripts/consumer_contract_smoke.mjs",
    "truth:gate": "npm run build --silent && node ./scripts/capability-truth-gate.mjs",
    "truth:gate:local": "npm run build --silent && TEST_CAPABILITIES_REQUIRE_AK_DIRECTION=1 node ./scripts/capability-truth-gate.mjs",
    "release:check": "npm run check && npm run truth:gate && npm run release:check:quick",
    "release:check:quick": "npm run consumer:smoke",
    "release:intent:check": "node ./scripts/validate-release-intent.mjs",
    "release:verify-public": "node ./scripts/public-cli-contract.mjs public",
    "test": "npm run build --silent && node --test tests/*.test.mjs",
    "test:property": "npm run build --silent && node --test tests/property_contract.test.mjs",
    "test:behavior": "npm run build --silent && cucumber-js --import tests/behavior/**/*.steps.mjs tests/behavior/**/*.feature",
    "test:behavior:raw": "cucumber-js --import tests/behavior/**/*.steps.mjs tests/behavior/**/*.feature",
    "test:ci-targeted": "npm run build --silent && node ./scripts/run_ci_targeted_tests.mjs",
    "test:runtime": "RUN_CONVEX_RUNTIME_TESTS=1 node --test tests/convex_runtime_contract_enforcement.test.mjs",
    "ci:smoke": "bash ./scripts/ci/smoke.sh",
    "ci:full": "bash ./scripts/ci/full.sh",
    "docs:list": "bash ./scripts/docs-list.sh",
    "docs:list:workspace": "bash ./scripts/docs-list.sh --workspace --discover",
    "docs:list:json": "bash ./scripts/docs-list.sh --json",
    "tech-stack": "bash ./scripts/tech-stack.sh",
    "capability:drill": "bash ./scripts/capability-drill.sh",
    "root-cause:corpus": "npm run build --silent && node ./scripts/root-cause-corpus.mjs",
    "runtime-diagnostic:corpus": "npm run build --silent && node ./scripts/runtime-diagnostic-corpus.mjs",
    "bombadil:smoke": "bash ./scripts/bombadil-rich-smoke.sh",
    "capability:passport": "npm run build --silent && node ./scripts/generate-capability-passport.mjs",
    "screening:witness-refresh": "bash ./scripts/screening/ts-quality-witness-refresh.sh",
    "screening:check": "bash ./scripts/screening/ts-quality-check.sh",
    "test-capabilities": "npm run build --silent && node ./bin/test-capabilities",
    "prepack": "npm run build",
    "loop-doctor": "bash -lc 'echo \"loop-doctor: test-capabilities diagnostics\"; node --version || true; npm --version || true; git status --short -- . || true; exit 0'",
    "loop-verify-fast": "npm run test:ci-targeted",
    "loop-impact-plan": "bash -lc 'changed=$( { git diff --name-only -- .; git ls-files --others --exclude-standard .; } | grep -v \"^$\" | sort -u ); echo \"loop-impact-plan: changed files\"; if [ -n \"$changed\" ]; then printf \"%s\\n\" \"$changed\"; else echo \"(none)\"; fi; if printf \"%s\\n\" \"$changed\" | grep -Eq \"^(package(-lock)?\\.json$|scripts/|src/|bin/|tests/|schemas/|examples/|test-capabilities\\.yaml)\"; then echo \"impact=wide\"; echo \"next=npm run loop-impact-wide\"; echo \"reason=runtime/package/test/schema/example surface changed; use release preflight validation\"; else echo \"impact=normal\"; echo \"next=npm run loop-impact-run\"; echo \"reason=docs/policy or localized non-runtime surface; use the normal quality gate\"; fi'",
    "loop-impact-run": "npm run check",
    "loop-impact-wide": "bash -lc 'echo \"loop-impact-wide: explicit wide validation accepted; reason=${LOOP_WIDE_REASON:-not-provided}\"; npm run verify'",
    "loop-landing-check": "npm run check"
  },
  "keywords": [
    "testing",
    "ai",
    "fail-closed",
    "self-healing-tests",
    "root-cause-analysis",
    "browser-automation",
    "fuzzing",
    "quantum-testing",
    "test-capabilities"
  ],
  "dependencies": {
    "chalk": "^4.1.2",
    "commander": "^12.0.0",
    "figlet": "^1.7.0",
    "js-yaml": "^4.1.0",
    "ora": "^5.4.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.14",
    "@cucumber/cucumber": "^12.8.1",
    "@types/figlet": "^1.5.8",
    "@types/node": "^22.0.0",
    "@typescript/native-preview": "^7.0.0-dev.20260511.1",
    "fast-check": "^4.7.0",
    "vitest": "^1.2.0"
  }
}
