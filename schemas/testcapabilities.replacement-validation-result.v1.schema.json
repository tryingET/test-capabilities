{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://softwareco.local/schemas/testcapabilities.replacement-validation-result.v1.schema.json",
  "title": "testcapabilities replacement-validation-result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "status",
    "requestSummary",
    "selectedCommands",
    "execution",
    "diagnostics",
    "nonAuthorizations",
    "authority"
  ],
  "properties": {
    "schemaVersion": {
      "const": "testcapabilities.replacement-validation-result.v1"
    },
    "status": {
      "type": "string",
      "enum": ["planned", "unsupported"]
    },
    "requestSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "packageNames", "changedPaths", "requiredProofCodes", "dryRun"],
      "properties": {
        "target": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "repositoryPath": { "type": "string", "minLength": 1 },
            "repositoryRef": { "type": "string", "minLength": 1 }
          }
        },
        "candidateChangeRef": { "$ref": "#/$defs/artifactRef" },
        "packageNames": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "changedPaths": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "requiredProofCodes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "dryRun": { "type": "boolean" }
      }
    },
    "selectedCommands": {
      "type": "array",
      "items": { "$ref": "#/$defs/selectedCommand" }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executed", "reason"],
      "properties": {
        "executed": { "const": false },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "diagnostics": {
      "type": "array",
      "items": { "$ref": "#/$defs/diagnostic" }
    },
    "nonAuthorizations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mutationAuthority",
        "dependencyChangeAuthority",
        "removalAuthority",
        "replacementAuthority",
        "mergeAuthority",
        "releaseAuthority",
        "exploitabilityAuthority",
        "disclosureAuthority",
        "trustCertificationAuthority"
      ],
      "properties": {
        "mutationAuthority": { "const": false },
        "dependencyChangeAuthority": { "const": false },
        "removalAuthority": { "const": false },
        "replacementAuthority": { "const": false },
        "mergeAuthority": { "const": false },
        "releaseAuthority": { "const": false },
        "exploitabilityAuthority": { "const": false },
        "disclosureAuthority": { "const": false },
        "trustCertificationAuthority": { "const": false }
      }
    },
    "authority": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "digest": { "type": "string", "minLength": 1 },
        "note": { "type": "string", "minLength": 1 }
      }
    },
    "selectedCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "mode", "authority"],
      "properties": {
        "command": { "type": "string", "minLength": 1 },
        "mode": { "const": "planned-not-executed" },
        "authority": { "type": "string", "minLength": 1 }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "code", "message"],
      "properties": {
        "level": { "type": "string", "enum": ["info", "warning", "error"] },
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 }
      }
    }
  }
}
