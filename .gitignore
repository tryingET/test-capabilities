# Node
node_modules/
npm-debug.log*

# Convex local state
.env.local
.convex/
convex/_generated/

# Local temp artifacts
# Repo-root isolated builds and fixture evidence (retain bytes; never source).
/.tmp/
# SCI workspace indexes/snapshots/logs, owned by the producer, not source ontology/.
/.ontology/
tmp/
out/
coverage/
.pi-subagent-sessions/

# Generated artifacts
dist/
ontology/*.generated.*
ontology/dist/
.ts-mutate/
.ts-quality/attestations/
.ts-quality/keys/
.ts-quality/locks/
.ts-quality/materialized/
.ts-quality/runs/
.ts-quality/tmp-mutants/
.ts-quality/latest.json
.ts-quality/mutation-manifest.json
.ts-quality/witnesses/*.json
!.ts-quality/witnesses/README.md

# Python caches/build metadata (vendored tooling)
**/__pycache__/
**/*.egg-info/

# Mutation receipts: the default receipts.dir under a project root (slice S5).
# Nothing here is ever deleted by the framework; deleting it is an interlock reset.
.test-capabilities/

# Generated projections (AK is the work authority; `ak work-items export` regenerates it)
governance/work-items.json
