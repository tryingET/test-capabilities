#!/usr/bin/env node

/**
 * TEST-CAPABILITIES - Fail-closed testing capability framework
 */

import path from "node:path";
import process from "node:process";
import { fileURLToPath, pathToFileURL } from "node:url";
import chalk from "chalk";
import { Command } from "commander";
import figlet from "figlet";
import ora from "ora";

function resolveRuntimeDistRoot() {
  if (process.env.TEST_CAPABILITIES_DIST_ROOT) {
    return path.resolve(process.env.TEST_CAPABILITIES_DIST_ROOT);
  }

  return path.resolve(path.dirname(fileURLToPath(import.meta.url)), "../dist");
}

function runtimeModuleUrl(modulePath) {
  return pathToFileURL(path.join(resolveRuntimeDistRoot(), modulePath)).href;
}

const {
  VERSION,
  assertSupportedCliCommand,
  executeCliOperation,
  renderErrorLine,
  toErrorEnvelope,
} = await import(runtimeModuleUrl("index.js"));

const program = new Command();

function showBanner() {
  console.log(
    chalk.cyan(
      figlet.textSync("TEST-CAPABILITIES", {
        font: "ANSI Shadow",
        horizontalLayout: "fitted",
      }),
    ),
  );
  console.log(chalk.dim(`  Fail-closed Testing Capability Framework v${VERSION}`));
  console.log();
}

function printSuiteSummary(summary) {
  const formatCoverageDimension = (label, value) =>
    summary.coverage.unmeasuredDimensions.includes(label) ? "unmeasured" : `${value}%`;
  const formatOverallCoverage = () => {
    switch (summary.coverage.status) {
      case "unmeasured":
        return "unmeasured";
      case "partial":
        return `partial(${summary.coverage.overall}%)`;
      default:
        return `${summary.coverage.overall}%`;
    }
  };

  console.log(`Health:  ${summary.health === "pass" ? chalk.green("pass") : chalk.red("fail")}`);
  console.log(`Findings: ${summary.findings}`);
  console.log(
    `Coverage: user=${formatCoverageDimension("userFlows", summary.coverage.userFlows)} api=${formatCoverageDimension("apiEndpoints", summary.coverage.apiEndpoints)} edge=${formatCoverageDimension("edgeCases", summary.coverage.edgeCases)} overall=${formatOverallCoverage()}`,
  );

  if (summary.coverage.unmeasuredDimensions.length > 0) {
    console.log(`Coverage gaps: ${summary.coverage.unmeasuredDimensions.join(", ")}`);
  }

  if (summary.predictions > 0) {
    console.log(`Predictions: ${summary.predictions}`);
  }

  if (summary.quantumUniverses) {
    console.log(`Quantum universes: ${summary.quantumUniverses}`);
  }
}

/**
 * Every failure leaves through here: `<message> [code]` on stderr in text mode, and the
 * surf-shaped envelope `{"error": {code, message, details}}` on stdout under `--json`, always
 * with exit 1 (result-classification packet, "Error codes"; architecture review A6; D3).
 */
function exitWithError(error, spinner, message, options = {}) {
  if (spinner) {
    spinner.fail(message);
  }

  if (options.json) {
    // the receipts travel in error.details.receipts of the same envelope
    console.log(JSON.stringify(toErrorEnvelope(error), null, 2));
  } else {
    // An unknown outcome is never silent: one line per receipt before the [code] line, so the
    // operator can see what was attempted before reading why it stopped (packet P1, A16).
    for (const receipt of error?.receipts ?? []) {
      console.error(chalk.dim(`${receipt.receipt_id} ${receipt.outcome} ${receipt.subject}`));
    }
    console.error(chalk.red(renderErrorLine(error)));
  }

  process.exit(1);
}

program.name("test-capabilities").description("Fail-closed testing capability framework").version(VERSION);

program
  .command("doctor")
  .description("Run zero-external-dependency package and environment diagnostics")
  .option("-c, --config <file>", "Validate a config file shape instead of only the packaged sample")
  .option("-t, --target <target>", "Resolve a CLI command/path or validate a web URL without executing it")
  .option("--json", "Print machine-readable diagnostics")
  .action(async (options) => {
    const shouldPrintJson = Boolean(options.json);
    if (!shouldPrintJson) {
      showBanner();
    }
    const spinner = shouldPrintJson
      ? undefined
      : ora("Running TEST-CAPABILITIES doctor...").start();

    try {
      assertSupportedCliCommand("doctor");
      const output = await executeCliOperation({ command: "doctor" }, options);

      if (shouldPrintJson) {
        console.log(JSON.stringify(output, null, 2));
      } else {
        const requiredText = `${output.summary.requiredPassed} required passed, ${output.summary.requiredFailed} failed`;
        if (output.status === "pass") {
          spinner?.succeed(`Doctor passed (${requiredText}).`);
        } else {
          spinner?.fail(`Doctor failed (${requiredText}).`);
        }

        for (const check of output.checks) {
          const marker =
            check.status === "pass" ? chalk.green("pass") : check.status === "warn" ? chalk.yellow("warn") : chalk.red("fail");
          const required = check.required ? "required" : "optional";
          console.log(`${marker} ${check.label} (${required}): ${check.detail}`);
        }
      }

      if (output.status !== "pass") {
        process.exit(1);
      }
    } catch (error) {
      exitWithError(error, spinner, "Doctor failed!", { json: shouldPrintJson });
    }
  });

program
  .command("init")
  .description("Generate a minimal fail-closed test-capabilities.yaml config")
  .option("-o, --output <file>", "Config file to write", "test-capabilities.yaml")
  .option("-t, --target <command>", "CLI command/path for the generated cli-tester target", "node")
  .option("--force", "Overwrite an existing output file")
  .option("--print", "Print the generated YAML instead of writing a file")
  .option("--json", "Print a machine-readable init envelope")
  .action(async (options) => {
    const shouldPrintJson = Boolean(options.json);
    if (!shouldPrintJson && !options.print) {
      showBanner();
    }
    const spinner = shouldPrintJson || options.print ? undefined : ora("Generating config...").start();

    try {
      assertSupportedCliCommand("init");
      const output = await executeCliOperation({ command: "init" }, options);

      if (shouldPrintJson) {
        console.log(JSON.stringify(output, null, 2));
      } else if (options.print) {
        process.stdout.write(output.configText);
      } else {
        spinner?.succeed(`Wrote ${output.outputPath}`);
        console.log(chalk.dim(`Next: ${output.nextCommands[0]}`));
        console.log(chalk.dim(`Then: ${output.nextCommands[1]}`));
      }
    } catch (error) {
      exitWithError(error, spinner, "Init failed!", { json: shouldPrintJson });
    }
  });

program
  .command("demo")
  .description("Run the built-in zero-external-dependency demo fixture")
  .option("--json", "Print machine-readable demo results")
  .action(async (options) => {
    const shouldPrintJson = Boolean(options.json);
    if (!shouldPrintJson) {
      showBanner();
    }
    const spinner = shouldPrintJson
      ? undefined
      : ora("Running TEST-CAPABILITIES built-in demo...").start();

    try {
      assertSupportedCliCommand("demo");
      const output = await executeCliOperation({ command: "demo" }, options);

      if (shouldPrintJson) {
        console.log(JSON.stringify(output, null, 2));
      } else {
        spinner?.succeed(`Demo complete (${output.summary.health}).`);
        console.log(`Core use case: ${output.coreUseCase.title}`);
        console.log(`Fixture: ${output.demo.cliFixture}`);
        printSuiteSummary(output.summary);
        console.log(chalk.dim(`Try next: ${output.coreUseCase.commands[2]}`));
      }

      if (output.summary.health !== "pass") {
        process.exit(1);
      }
    } catch (error) {
      exitWithError(error, spinner, "Demo failed!", { json: shouldPrintJson });
    }
  });

program
  .command("test")
  .description("Run capability-backed testing suite")
  .option(
    "-t, --target <target>",
    "CLI command/path target, or a URL when a real web consumer is enabled (currently: quantum or an enabled bombadil/surf agent)",
  )
  .option("-c, --config <file>", "Configuration file", "test-capabilities.yaml")
  .option("-a, --autonomous", "Enable full autonomous mode")
  .option("--self-heal", "Enable self-healing tests")
  .option(
    "--supersede-receipt <receipt_id>",
    "Proceed past an in-doubt mutation receipt you have inspected; the new receipt records which one it supersedes",
  )
  .option("--predict", "Enable failure prediction")
  .option("--quick", "Quick sanity check mode")
  .option("--fail-threshold <level>", "Fail threshold (low|medium|high|critical)")
  .option("--upload-artifacts", "Upload artifacts to cloud")
  .option("--report <dir>", "Report output directory")
  .option("--json", "Print the full machine-readable operation envelope")
  .action(async (options) => {
    const shouldPrintJson = Boolean(options.json);
    if (!shouldPrintJson) {
      showBanner();
    }
    const spinner = shouldPrintJson
      ? undefined
      : ora("Initializing TEST-CAPABILITIES operation kernel...").start();

    try {
      assertSupportedCliCommand("test");
      if (spinner) {
        spinner.text = options.quick
          ? "Executing registered test operation (quick)..."
          : "Executing registered test operation...";
      }

      const output = await executeCliOperation({ command: "test" }, options, {
        supersedeReceiptId: options.supersedeReceipt,
      });
      if (shouldPrintJson) {
        console.log(JSON.stringify(output, null, 2));
      } else {
        spinner?.succeed(`Testing complete (${output.summary.health}).`);
        printSuiteSummary(output.summary);
      }

      if (output.summary.health !== "pass") {
        process.exit(1);
      }
    } catch (error) {
      exitWithError(error, spinner, "Testing failed!", { json: shouldPrintJson });
    }
  });

function collectRepeated(value, previous) {
  return [...previous, value];
}

program
  .command("surf")
  .description("Advanced browser testing with surf-cli")
  .argument("<action>", "Action: explore | plan (implemented) | apply | flow | assert | compare | replay")
  .option("-u, --url <url>", "Target URL")
  .option("--depth <n>", "Explore same-origin links to bounded depth 1-3 with graded probe coverage")
  .option(
    "--ready-selector <css>",
    "surf explore: a visible CSS selector the readiness gate waits for; a selector it cannot reach is diagnosed against the page's frames",
  )
  .option(
    "--frame-hint <kind=value>",
    "surf explore: 'urlPrefix=<prefix>' or 'selector=<css>' asserting which frame the --ready-selector target lives in; the only way to confirm a frame boundary",
  )
  .option(
    "--frame-probe",
    "surf explore: with --ready-selector and no --frame-hint, look for the selector inside each top-level candidate frame (frame.switch, wait.element, frame.main); one hit with every candidate answering confirms the frame",
  )
  .option(
    "--a11y-snapshot [mode]",
    "surf explore: attach the read-only accessibility observation channel (one surf page.read --structure --full-page --nodes in the owned tab); 'optional' (default) records an unavailable channel and continues, 'required' fails the page",
  )
  .option(
    "--field <locator=value>",
    "surf plan: a field to fill, as '<label|selector|name>:<locator>=<value>'; repeatable",
    collectRepeated,
    [],
  )
  .option("--submit-text <text>", "surf plan: narrow the submit candidates by visible button text")
  .option("--submit-selector <css>", "surf plan: narrow the submit candidates by CSS selector")
  .option("--out <file>", "surf plan: write the reviewable plan artifact here (mode 0600)")
  .option("--plan <file>", "surf apply: the plan artifact to carry out")
  .option(
    "--submit",
    "surf apply: open the submit gate; needs --confirm-plan and an allowlisted origin",
  )
  .option("--confirm-plan <token>", "surf apply: the approval token printed by surf plan")
  .option("--until-url-prefix <prefix>", "surf apply: post-condition, the URL starts with this")
  .option("--until-text <text>", "surf apply: post-condition, the page contains this text")
  .option("--receipt-out <file>", "surf apply: export this run's mutation receipts as one JSON")
  .option(
    "-c, --config <file>",
    "surf plan/apply: config file holding mutation.allowOrigins, receipts.dir and surf.submit.*",
    "test-capabilities.yaml",
  )
  .option("--record", "Reserved surf explore flag; currently fails until implemented")
  .option("--validate", "Reserved surf explore flag; currently fails until implemented")
  .option(
    "--baseline <dir>",
    "Reserved surf explore flag; currently fails until implemented",
  )
  .option("--ai-diff", "Reserved surf explore flag; currently fails until implemented")
  .option("-f, --file <path>", "Reserved surf flag; currently fails until implemented")
  .option("--json", "Print the full machine-readable operation envelope")
  .action(async (action, options) => {
    const shouldPrintJson = Boolean(options.json);
    // `plan` and `apply` keep stdout machine-readable in text mode as well: the plan prints its
    // approval token as the only line on stdout so an operator can copy it (packet §4.1).
    const quiet = action === "plan" || action === "apply";
    if (!shouldPrintJson && !quiet) {
      showBanner();
    }
    const spinner =
      shouldPrintJson || quiet
        ? undefined
        : ora(`Resolving surf ${action} through the operation kernel...`).start();

    try {
      assertSupportedCliCommand("surf");
      const output = await executeCliOperation({ command: "surf", action }, options);

      if (shouldPrintJson) {
        console.log(JSON.stringify(output, null, 2));
      } else if (action === "apply") {
        const submitted =
          output.result.submitted === true
            ? "submitted"
            : output.result.submitted === "unknown"
              ? "submitted=unknown"
              : "not submitted";
        console.log(
          `plan ${output.plan.planId} ${output.result.mode}: ${output.result.fields.length} field(s) set and read back, ${submitted}`,
        );
        if (output.receipt) {
          console.error(chalk.dim(`Receipt ${output.receipt.outcome}: ${output.receipt.path}`));
        }
      } else if (action === "plan") {
        console.error(
          chalk.dim(
            `Plan ${output.plan.planId} written to ${output.plan.path} (${output.result.fields.length} field(s), submit ${output.result.submit.status}).`,
          ),
        );
        console.log(output.plan.approvalToken);
      } else {
        spinner?.succeed(`Surf ${action} complete.`);
        if (output.result.stdout) {
          console.log(output.result.stdout);
        }
        if (output.result.stderr) {
          console.error(output.result.stderr);
        }
        if (output.result.coverage) {
          console.log(
            `Surf coverage: userFlows=${output.result.coverage.userFlows}% probes=${output.result.coverage.probesVerified}/${output.result.coverage.probesRequired} status=${output.result.coverage.status}`,
          );
        }
      }
    } catch (error) {
      exitWithError(error, spinner, `Surf ${action} failed!`, { json: shouldPrintJson });
    }
  });

program
  .command("predict")
  .description("Predict potential failures using ML")
  .option("-t, --target <url>", "Target URL")
  .option("--history <dir>", "Historical test data directory")
  .option("--horizon <hours>", "Prediction horizon in hours", "24")
  .action(async () => {
    showBanner();
    const spinner = ora("Checking prediction capability...").start();

    try {
      assertSupportedCliCommand("predict");
      spinner.succeed("Prediction capability is available.");
    } catch (error) {
      exitWithError(error, spinner, "Prediction is unavailable.");
    }
  });

program
  .command("quantum")
  .description("Run quantum test simulation")
  .option("-t, --target <url>", "Target URL")
  .option("-b, --branches <n>", "Positive integer branch count", "100")
  .option("--collapse", "Collapse results to significant findings")
  .action(async (options) => {
    showBanner();
    const spinner = ora("Executing registered quantum operation...").start();

    try {
      assertSupportedCliCommand("quantum");
      const output = await executeCliOperation({ command: "quantum" }, options);

      spinner.succeed("Quantum simulation complete.");
      console.log(`Universes Simulated: ${output.result.branchesSimulated}`);
      console.log(`Unique Paths:        ${output.result.uniquePaths}`);
      console.log(`Edge Cases:          ${output.result.edgeCases.length}`);
      console.log(`Rare Bugs:           ${output.result.rareBugs.length}`);
    } catch (error) {
      exitWithError(error, spinner, "Quantum simulation failed!");
    }
  });

program
  .command("heal")
  .description("Analyze and fix broken tests")
  .option("-d, --dir <path>", "Tests directory", "./tests")
  .option("--dry-run", "Show what would be fixed")
  .option(
    "--proposal-output <file>",
    "Write a dry-run healing proposal artifact as JSON for review or replay-ledger follow-through",
  )
  .option(
    "--verification-output <file>",
    "Write a dry-run healing verification artifact as JSON after checking proposals in memory",
  )
  .option(
    "--proposal-input <file>",
    "Apply proposals from a previously emitted healing proposal artifact; requires --checkpoint-ref",
  )
  .option(
    "--checkpoint-ref <ref>",
    "External checkpoint identity required before applying healing proposals",
  )
  .option(
    "--findings-input <file>",
    "Read diagnostic findings JSON so proposals can cite triggeringFindingId evidence",
  )
  .option(
    "--receipt-output <file>",
    "Apply mode only: export this run's mutation receipts as one JSON artifact (the per-receipt files under receipts.dir are written either way)",
  )
  .option(
    "--supersede-receipt <receipt_id>",
    "Apply mode only: proceed past an in-doubt receipt you have inspected; the new receipt records which one it supersedes",
  )
  .action(async (options) => {
    showBanner();
    const spinner = ora("Executing registered healing operation...").start();

    try {
      assertSupportedCliCommand("heal");
      const output = await executeCliOperation({ command: "heal" }, options, {
        supersedeReceiptId: options.supersedeReceipt,
      });

      if (output.proposals.length === 0) {
        spinner.succeed("No healing proposals found.");
        if (output.proposalArtifact) {
          console.log(chalk.dim(`Proposal artifact: ${output.proposalArtifact.path}`));
        }
        if (output.verificationArtifact) {
          console.log(chalk.dim(`Verification artifact: ${output.verificationArtifact.path}`));
        }
        return;
      }

      if (output.input.dryRun) {
        spinner.stop();
        console.log(chalk.bold("Proposed fixes:"));
        for (const proposal of output.proposals) {
          console.log(`${proposal.file}:${proposal.line}`);
          console.log(chalk.red(`  - ${proposal.oldSelector}`));
          console.log(chalk.green(`  + ${proposal.newSelector}`));
          console.log(chalk.dim(`    confidence=${proposal.confidence}`));
        }
        if (output.proposalArtifact) {
          console.log(chalk.dim(`Proposal artifact: ${output.proposalArtifact.path}`));
        }
        if (output.verificationArtifact) {
          console.log(chalk.dim(`Verification artifact: ${output.verificationArtifact.path}`));
        }
        return;
      }

      spinner.succeed(`Applied ${output.appliedCount} healing proposal(s).`);
      if (output.checkpointRef) {
        console.log(chalk.dim(`Checkpoint ref: ${output.checkpointRef}`));
      }
      if (output.receiptArtifact) {
        console.log(chalk.dim(`Receipt artifact: ${output.receiptArtifact.path}`));
      }
      for (const receipt of output.mutations ?? []) {
        console.log(chalk.dim(`Receipt ${receipt.receipt_id} ${receipt.outcome} ${receipt.subject}`));
      }
    } catch (error) {
      exitWithError(error, spinner, "Healing failed!");
    }
  });

program
  .command("replacement-validation")
  .description("Plan dependency replacement validation from an explicit dep-surgeon request")
  .argument("<action>", "Action: plan")
  .requiredOption("--request <file>", "testcapabilities.replacement-validation-request.v1 JSON file")
  .option("--out <file>", "Write testcapabilities.replacement-validation-result.v1 JSON")
  .option("--json", "Print machine-readable validation planning envelope")
  .action(async (action, options) => {
    const shouldPrintJson = Boolean(options.json);
    if (!shouldPrintJson) {
      showBanner();
    }
    const spinner = shouldPrintJson
      ? undefined
      : ora("Planning replacement validation...").start();

    try {
      assertSupportedCliCommand("replacement-validation");
      const output = await executeCliOperation({ command: "replacement-validation" }, {
        action,
        request: options.request,
        out: options.out,
        json: shouldPrintJson,
      });

      if (shouldPrintJson) {
        console.log(JSON.stringify(output, null, 2));
      } else {
        spinner?.succeed(`Replacement validation ${output.result.status}.`);
        for (const selected of output.result.selectedCommands) {
          console.log(`${chalk.green("plan")} ${selected.command}`);
        }
        if (options.out) {
          console.log(chalk.dim(`Result artifact: ${options.out}`));
        }
      }

      if (output.result.status !== "planned") {
        process.exit(1);
      }
    } catch (error) {
      exitWithError(error, spinner, "Replacement validation planning failed!", { json: shouldPrintJson });
    }
  });

