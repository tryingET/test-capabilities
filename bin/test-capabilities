#!/usr/bin/env node

/**
 * TEST-CAPABILITIES - Autonomous Testing Framework
 */

import { spawn } from "node:child_process";
import fs from "node:fs";
import path from "node:path";
import process from "node:process";
import chalk from "chalk";
import { Command } from "commander";
import figlet from "figlet";
import yaml from "js-yaml";
import ora from "ora";
import {
  QuantumTestRunner,
  TestCapabilitiesConfigSchema,
  TestCapabilitiesOrchestrator,
  TestFileHealer,
  VERSION,
} from "../dist/index.js";
import {
  assertSupportedCliCommand,
  assertSupportedSurfAction,
  assertSupportedTestOptions,
} from "../dist/core/capabilities.js";

const program = new Command();

function showBanner() {
  console.log(
    chalk.cyan(
      figlet.textSync("TEST-CAPABILITIES", {
        font: "ANSI Shadow",
        horizontalLayout: "fitted",
      }),
    ),
  );
  console.log(chalk.dim(`  Autonomous Testing Framework v${VERSION}`));
  console.log();
}

function isUrl(value) {
  try {
    new URL(value);
    return true;
  } catch {
    return false;
  }
}

function applyTargetOverride(config, target) {
  if (!target) {
    return config;
  }

  const targets = { ...(config.targets ?? {}) };
  if (isUrl(target)) {
    targets.web = target;
  } else {
    targets.cli = target;
  }

  return {
    ...config,
    targets,
  };
}

function applyQuickMode(config) {
  return {
    ...config,
    intelligence: {
      ...(config.intelligence ?? {}),
      prediction: false,
    },
    quantum: {
      ...(config.quantum ?? {}),
      enabled: false,
    },
  };
}

function loadConfig(file) {
  const configPath = path.resolve(file);

  if (!fs.existsSync(configPath)) {
    throw new Error(`Config file not found: ${configPath}`);
  }

  const raw = yaml.load(fs.readFileSync(configPath, "utf8")) ?? {};
  return TestCapabilitiesConfigSchema.parse(raw);
}

async function runSuite(config) {
  const orchestrator = new TestCapabilitiesOrchestrator(config);
  return orchestrator.run();
}

function printSuiteSummary(result) {
  console.log(`Health:  ${result.passed ? chalk.green("pass") : chalk.red("fail")}`);
  console.log(`Findings: ${result.findings.length}`);
  console.log(
    `Coverage: user=${result.coverage.userFlows}% api=${result.coverage.apiEndpoints}% edge=${result.coverage.edgeCases}% overall=${result.coverage.overall}%`,
  );

  if (result.predictions?.length) {
    console.log(`Predictions: ${result.predictions.length}`);
  }

  if (result.quantumInsights) {
    console.log(`Quantum universes: ${result.quantumInsights.universesSimulated}`);
  }
}

function exitWithError(error, spinner, message) {
  if (spinner) {
    spinner.fail(message);
  }

  const rendered = error instanceof Error ? error.message : String(error);
  console.error(chalk.red(rendered));
  process.exit(1);
}

async function runSurfCommand(args, { inherit = true } = {}) {
  return new Promise((resolve, reject) => {
    const proc = spawn("surf", args, {
      stdio: inherit ? "inherit" : ["ignore", "pipe", "pipe"],
    });

    let stdout = "";
    let stderr = "";

    if (!inherit) {
      proc.stdout.on("data", (chunk) => {
        stdout += String(chunk);
      });
      proc.stderr.on("data", (chunk) => {
        stderr += String(chunk);
      });
    }

    proc.on("close", (code) => {
      if (code === 0) {
        resolve({ code, stdout, stderr });
        return;
      }

      reject(new Error(stderr.trim() || stdout.trim() || `surf exited with code ${code}`));
    });

    proc.on("error", (error) => {
      reject(new Error(`Failed to run surf: ${error.message}`));
    });
  });
}

function collectFiles(rootDir) {
  if (!fs.existsSync(rootDir)) {
    return [];
  }

  const entries = fs.readdirSync(rootDir, { withFileTypes: true });
  const files = [];

  for (const entry of entries) {
    const fullPath = path.join(rootDir, entry.name);

    if (entry.isDirectory()) {
      files.push(...collectFiles(fullPath));
      continue;
    }

    if (/\.(c|m)?[jt]sx?$/.test(entry.name)) {
      files.push(fullPath);
    }
  }

  return files.sort();
}

program.name("test-capabilities").description("The Future of AI-Driven Testing").version(VERSION);

program
  .command("test")
  .description("Run autonomous testing suite")
  .option("-t, --target <url>", "Target URL or path")
  .option("-c, --config <file>", "Configuration file", "test-capabilities.yaml")
  .option("-a, --autonomous", "Enable full autonomous mode")
  .option("--self-heal", "Enable self-healing tests")
  .option("--predict", "Enable failure prediction")
  .option("--quick", "Quick sanity check mode")
  .option("--fail-threshold <level>", "Fail threshold (low|medium|high|critical)")
  .option("--upload-artifacts", "Upload artifacts to cloud")
  .option("--report <dir>", "Report output directory")
  .action(async (options) => {
    showBanner();
    const spinner = ora("Initializing TEST-CAPABILITIES testing engine...").start();

    try {
      assertSupportedCliCommand("test");
      assertSupportedTestOptions(options);

      spinner.text = "Loading configuration...";
      let config = loadConfig(options.config);
      config = applyTargetOverride(config, options.target);

      if (options.selfHeal) {
        config = {
          ...config,
          intelligence: {
            ...(config.intelligence ?? {}),
            selfHealing: true,
          },
        };
      }

      if (options.predict) {
        config = {
          ...config,
          intelligence: {
            ...(config.intelligence ?? {}),
            prediction: true,
          },
        };
      }

      if (options.quick) {
        spinner.text = "Running quick deterministic smoke...";
        config = applyQuickMode(config);
      } else if (options.autonomous) {
        spinner.text = "Executing autonomous suite...";
      } else {
        spinner.text = "Executing standard suite...";
      }

      const result = await runSuite(config);
      spinner.succeed(`Testing complete (${result.passed ? "passed" : "failed"}).`);
      printSuiteSummary(result);

      if (!result.passed) {
        process.exit(1);
      }
    } catch (error) {
      exitWithError(error, spinner, "Testing failed!");
    }
  });

program
  .command("surf")
  .description("Advanced browser testing with surf-cli")
  .argument("<action>", "Action: explore | flow | assert | compare | replay")
  .option("-u, --url <url>", "Target URL")
  .option("--depth <n>", "Exploration depth", "3")
  .option("--record", "Record the session")
  .option("--validate", "Run AI validation")
  .option("--baseline <dir>", "Baseline directory for comparison")
  .option("--ai-diff", "Use AI for visual diff")
  .option("-f, --file <path>", "Session file to replay")
  .action(async (action, options) => {
    showBanner();
    const spinner = ora(`Executing surf ${action}...`).start();

    try {
      assertSupportedCliCommand("surf");
      assertSupportedSurfAction(action);

      switch (action) {
        case "explore":
          spinner.text = `Exploring ${options.url ?? "about:blank"}...`;
          await runSurfCommand(["go", options.url ?? "about:blank"]);
          break;
        case "flow":
          spinner.text = `Running flow on ${options.url ?? "about:blank"}...`;
          await runSurfCommand(["go", options.url ?? "about:blank"]);
          if (options.record) {
            console.log(chalk.dim("Recording requested; rely on surf session tooling for capture."));
          }
          if (options.validate) {
            console.log(chalk.dim("Validation requested; review resulting surf transcript."));
          }
          break;
        case "assert":
          spinner.text = `Opening ${options.url ?? "about:blank"} for manual assertion review...`;
          await runSurfCommand(["go", options.url ?? "about:blank"]);
          break;
        case "compare":
          spinner.text = `Preparing visual comparison against ${options.baseline ?? "./baselines"}...`;
          console.log(chalk.dim(`AI diff: ${options.aiDiff ? "enabled" : "disabled"}`));
          break;
        case "replay":
          spinner.text = `Replaying session ${options.file ?? "(missing --file)"}...`;
          if (!options.file) {
            throw new Error("replay requires --file");
          }
          console.log(chalk.dim(`Replay file: ${options.file}`));
          break;
        default:
          throw new Error(`Unknown action: ${action}`);
      }

      spinner.succeed(`Surf ${action} complete.`);
    } catch (error) {
      exitWithError(error, spinner, `Surf ${action} failed!`);
    }
  });

program
  .command("predict")
  .description("Predict potential failures using ML")
  .option("-t, --target <url>", "Target URL")
  .option("--history <dir>", "Historical test data directory")
  .option("--horizon <hours>", "Prediction horizon in hours", "24")
  .action(async () => {
    showBanner();
    const spinner = ora("Checking prediction capability...").start();

    try {
      assertSupportedCliCommand("predict");
      spinner.succeed("Prediction capability is available.");
    } catch (error) {
      exitWithError(error, spinner, "Prediction is unavailable.");
    }
  });

program
  .command("quantum")
  .description("Run quantum test simulation")
  .option("-t, --target <url>", "Target URL")
  .option("-b, --branches <n>", "Number of parallel universes", "100")
  .option("--collapse", "Collapse results to significant findings")
  .action(async (options) => {
    showBanner();
    const spinner = ora("Initiating quantum simulation...").start();

    try {
      assertSupportedCliCommand("quantum");

      const runner = new QuantumTestRunner({
        branches: Number(options.branches),
        collapseStrategy: options.collapse ? "significance" : "coverage",
        seed: 42,
      });
      const results = await runner.run(options.target ?? "https://example.com");

      spinner.succeed("Quantum simulation complete.");
      console.log(`Universes Simulated: ${results.branchesSimulated}`);
      console.log(`Unique Paths:        ${results.uniquePaths}`);
      console.log(`Edge Cases:          ${results.edgeCases.length}`);
      console.log(`Rare Bugs:           ${results.rareBugs.length}`);
    } catch (error) {
      exitWithError(error, spinner, "Quantum simulation failed!");
    }
  });

program
  .command("heal")
  .description("Analyze and fix broken tests")
  .option("-d, --dir <path>", "Tests directory", "./tests")
  .option("--dry-run", "Show what would be fixed")
  .action(async (options) => {
    showBanner();
    const spinner = ora("Analyzing broken tests...").start();

    try {
      assertSupportedCliCommand("heal");

      const healer = new TestFileHealer();
      const files = collectFiles(path.resolve(options.dir));
      const proposals = [];

      for (const file of files) {
        const fileProposals = await healer.analyzeFile(file);
        proposals.push(...fileProposals);
      }

      if (proposals.length === 0) {
        spinner.succeed("No healing proposals found.");
        return;
      }

      if (options.dryRun) {
        spinner.stop();
        console.log(chalk.bold("Proposed fixes:"));
        for (const proposal of proposals) {
          console.log(`${proposal.file}:${proposal.line}`);
          console.log(chalk.red(`  - ${proposal.oldSelector}`));
          console.log(chalk.green(`  + ${proposal.newSelector}`));
          console.log(chalk.dim(`    confidence=${proposal.confidence}`));
        }
        return;
      }

      for (const proposal of proposals) {
        await healer.applyProposal(proposal);
      }

      spinner.succeed(`Applied ${proposals.length} healing proposal(s).`);
    } catch (error) {
      exitWithError(error, spinner, "Healing failed!");
    }
  });

program
  .command("visualize")
  .description("Generate interactive test visualization")
  .option("-o, --output <file>", "Output HTML file", "test-capabilities-viz.html")
  .option("--real-time", "Enable real-time updates")
  .option("--port <n>", "Port for real-time dashboard", "3001")
  .action(async () => {
    showBanner();
    const spinner = ora("Checking visualization capability...").start();

    try {
      assertSupportedCliCommand("visualize");
      spinner.succeed("Visualization capability is available.");
    } catch (error) {
      exitWithError(error, spinner, "Visualization is unavailable.");
    }
  });

program
  .command("report")
  .description("Generate comprehensive test report")
  .option("-i, --input <dir>", "Input data directory", "./reports")
  .option("-o, --output <dir>", "Output directory", "./reports")
  .option("-f, --format <formats>", "Formats (json,html,md)", "html,json")
  .option("--upload", "Upload to configured destination")
  .action(async () => {
    showBanner();
    const spinner = ora("Checking report capability...").start();

    try {
      assertSupportedCliCommand("report");
      spinner.succeed("Report capability is available.");
    } catch (error) {
      exitWithError(error, spinner, "Report generation is unavailable.");
    }
  });

program.parseAsync(process.argv).catch((error) => {
  exitWithError(error, null, "Command failed!");
});
